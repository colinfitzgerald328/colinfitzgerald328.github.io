---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const PDF = "/assets/resume/colinfitzgerald_resume_2026.pdf";

const experience = [
  {
    role: "Senior Software Engineer, Air Scribe",
    org: "Commure, Mountain View, CA",
    when: "Jul 2025 to present",
    points: [
      "Leading development of configurable carry-forward, allowing clinics and individual providers to control which sections of a prior visit's note pre-fill the next, reducing documentation burden.",
      "Led Air Scribe Orders from scoping to launch: the scribe detects orders clinicians discuss during the visit conversation and drafts them for review, cutting manual order entry. Defined requirements with the PM, authored the technical design and premortem, and shipped behind a kill switch with a staged rollout.",
      "Made visit recording durable across the web app and the React Native mobile app, so clinicians never lose a session's audio: built offline recording on mobile that keeps capturing when the network drops and syncs once connectivity returns, and tuned MediaRecorder settings (codec, bitrate, chunking) per platform.",
      "Own reliability of Air Scribe's Cloud Run services as clinic volume scaled: slimmed the audio-processing service's Docker image and cut cold-start latency so new instances absorb traffic spikes without slowing notes. Run production incidents end-to-end, from root cause and staged fixes to customer communication, then ship systemic fixes so they don't recur.",
    ],
  },
  {
    role: "Software Engineer, Air EHR and Air Scribe",
    org: "Commure, Mountain View, CA",
    when: "Jan 2024 to Jul 2025",
    points: [
      "Core engineer on Air, Commure's AI-native EHR (ambient scribing, charting, billing), from the 0-to-1 build through its July 2025 launch and growth to $10M+ ARR.",
      "Built the Air Scribe backend from scratch: the pipeline that turns visit audio into a structured physical therapy note through LLM-based transcription and note generation. Moving from multi-threading to async I/O made note processing 3x faster.",
      "Diagnosed and resolved a company-wide container memory bug, reducing cold starts from over 4 minutes to under 10 seconds and lowering cloud spend.",
    ],
  },
  {
    role: "Full-Stack Engineer",
    org: "RoBhat Labs (acquired by Commure), Berkeley, CA",
    when: "Jun 2022 to Jan 2024",
    points: [
      "Designed and built content-ranking infrastructure, increasing D1 retention by 7% and aggregate notification engagement 5x.",
      "Built a semantic search application for internal operators, reducing manual work by 25%.",
      "Managed a team of 10 content operators, leading weekly reviews of quality and throughput.",
    ],
  },
  {
    role: "Data Science Intern",
    org: "CoreVest Finance, Irvine, CA",
    when: "May 2021 to Aug 2021",
    points: [
      "Built an OCR-based ETL pipeline over 1,000+ PDF loan applications and led an intern team in training a random forest model on it to assist underwriters.",
    ],
  },
];

const projects = [
  {
    name: "MyLogbook",
    url: "https://mylogbook.run",
    host: "mylogbook.run",
    summary: "AI training coach for runners and cyclists; designed, built, and launched solo, now in beta.",
    points: [
      "Safety harness for training: fuses Strava and Garmin activities, recovery data, and LLM-parsed logs into one view of training load, re-planning around missed sessions and fatigue so athletes progress without overreaching.",
      "TypeScript API (Hono, React, Drizzle) on Postgres with row-level security, plus Python services for Garmin sync and multi-GB export parsing, run as retried QStash jobs off the request path.",
    ],
  },
  {
    name: "Daybook",
    url: "https://daybook.fitzgeraldmedia.org",
    host: "daybook.fitzgeraldmedia.org",
    summary: "Photo and video journal that preserves full-resolution originals, with a feed for sharing with friends and family.",
    points: [
      "Edge-first media: direct-to-R2 uploads and Cloudflare CDN resizing serve a 3.3 MB JPEG as a ~12 KB AVIF in ~150 ms; a Worker signs video URLs per viewer.",
      "Social graph in Postgres: follow edges feed a single connections view that gates the feed, post visibility, and notifications, with keyset pagination for stable pages.",
      "GPU video pipeline transcodes 4K HDR footage without losing color. Stack: Go, Next.js, PostgreSQL, Cloudflare.",
    ],
  },
];

const skills = [
  ["Languages", "Python, TypeScript/JavaScript, SQL"],
  ["Frontend and mobile", "React, React Native, Next.js, TanStack"],
  ["Backend and data", "FastAPI, asyncio, SQLAlchemy, Pydantic, Node.js, PostgreSQL, MySQL"],
  ["Infrastructure", "GCP (GKE, Cloud Run, Cloud Tasks), AWS (Lambda, SQS), Terraform, Kubernetes, Docker, GitHub Actions"],
];

const earlier = [
  ["2025", "/assets/resume/colinfitzgerald_resume_2025.pdf"],
  ["2025, later revision", "/assets/resume/Colin_FitzGerald_2025_Resume-29.pdf"],
  ["December 2023", "/assets/resume/colinfitzgerald_resume_2023_12_7.pdf"],
  ["2023", "/assets/resume/Colin_FitzGerald_2023_Resume-6.pdf"],
  ["Tech resume", "/assets/resume/colinfitzgerald_tech_resume.pdf"],
  ["Tech resume, earlier", "/assets/resume/colinfitzgerald_techresume.pdf"],
  ["2021", "/assets/resume/Colin%20FitzGerald%20Resume%202021.pdf"],
];
---

<Base title="Resume | Colin FitzGerald">
  <section class="band">
    <div class="wrap head">
      <Header current="resume" />
      <div class="head-grid">
        <div class="head-copy">
          <h1 class="display">Resume</h1>
          <p class="lede">
            Product engineer building AI tools for clinicians. Helped build Air, Commure's AI-native EHR, from 0 to 1, then
            built the backend for Air Scribe, an ambient AI scribe for physical therapy. Now leading features end-to-end with
            product as Air Scribe scales.
          </p>
          <p class="contact">
            <span>San Francisco, CA</span>
            <a href="mailto:colinfitzgerald328@gmail.com">colinfitzgerald328@gmail.com</a>
            <a href="https://linkedin.com/in/colinfitzgerald328">LinkedIn</a>
            <a href="https://github.com/colinfitzgerald328">GitHub</a>
          </p>
        </div>
        <a href={PDF} class="pill pill-lane">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="M7 10l5 5 5-5" /><path d="M5 21h14" /></svg>
          Download the PDF
        </a>
      </div>
    </div>
  </section>

  <main class="wrap body">
    <section class="row" aria-labelledby="cv-exp">
      <h2 id="cv-exp" class="display">Experience</h2>
      <div class="col">
        {
          experience.map((e) => (
            <div class="entry">
              <div class="entry-head">
                <h3>{e.role}</h3>
                <span class="muted when">{e.when}</span>
              </div>
              <p class="muted org">{e.org}</p>
              <ul>
                {e.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="row" aria-labelledby="cv-proj">
      <h2 id="cv-proj" class="display">Projects</h2>
      <div class="col">
        {
          projects.map((p) => (
            <div class="entry">
              <div class="entry-head">
                <h3>{p.name}</h3>
                <a href={p.url} class="when">{p.host}</a>
              </div>
              <p>{p.summary}</p>
              <ul>
                {p.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="row" aria-labelledby="cv-skills">
      <h2 id="cv-skills" class="display">Skills</h2>
      <dl class="col skills">
        {
          skills.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="row" aria-labelledby="cv-edu">
      <h2 id="cv-edu" class="display">Education</h2>
      <div class="col">
        <div class="entry">
          <div class="entry-head">
            <h3>University of California, Berkeley</h3>
            <span class="muted when">2018 to 2022</span>
          </div>
          <p class="muted org">B.A. in Economics, Minor in Data Science</p>
          <p>Track and Field team captain; led the team through PAC-12 Championships while training 25+ hours per week.</p>
        </div>
      </div>
    </section>

    <section class="row last" aria-labelledby="cv-old">
      <h2 id="cv-old" class="display">Earlier versions</h2>
      <div class="col">
        <p class="muted">Past resumes, kept for the record.</p>
        <ul class="archive">
          {
            earlier.map(([label, href]) => (
              <li>
                <a href={href}>
                  <strong>{label}</strong>
                  <span class="muted">Resume, PDF</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .head {
    padding-bottom: 56px;
  }
  .head-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 48px;
  }
  .head-copy {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 {
    font-weight: 900;
    font-size: clamp(60px, 8vw, 116px);
    line-height: 0.9;
  }
  .lede {
    margin: 0;
    max-width: 34em;
    font-size: 20px;
    color: var(--on-track-muted);
  }
  .contact {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    font-size: 16px;
  }
  .contact > * {
    padding: 10px 0;
  }
  .contact span {
    color: var(--on-track-muted);
  }

  .body {
    padding-top: 24px;
    padding-bottom: 96px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    padding: 56px 0;
    border-bottom: 3px solid var(--ink);
  }
  .row.last {
    border-bottom: none;
    padding-bottom: 0;
  }
  .row h2 {
    flex: 1 1 220px;
    font-size: 44px;
    line-height: 1;
  }
  .col {
    flex: 999 1 600px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
  }
  .entry h3 {
    font-size: 23px;
    line-height: 1.3;
  }
  .when,
  .org {
    font-size: 16px;
  }
  .when {
    font-variant-numeric: tabular-nums;
  }
  .entry p {
    margin: 0;
  }
  .entry ul {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--ink-2);
    max-width: 46em;
  }
  .skills {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px 40px;
  }
  .skills div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .skills dt {
    font-weight: 700;
  }
  .skills dd {
    margin: 0;
    color: var(--ink-2);
  }
  .col > p {
    margin: 0;
  }
  .archive {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }
  .archive a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px;
    background: #ffffff;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    box-shadow: inset 0 0 0 2px transparent;
  }
  .archive a:hover {
    box-shadow: inset 0 0 0 2px var(--track);
  }
  .archive span {
    font-size: 15px;
  }
</style>
